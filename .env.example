# Server-only PayPal Sandbox credentials. Live PayPal endpoints are rejected.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"

# Custom OpenAI-compatible Chat Completions provider (include /v1 if required).
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://your-provider.example/v1"
OPENAI_MODEL="your-model-id"

# Neon: pooled runtime URL and direct migration URL.
DATABASE_URL=""
DIRECT_URL=""

# At least 16 and 32 characters respectively. Never commit actual values.
MAINTAINER_PASSWORD=""
SESSION_SECRET=""

# Read-only financial access with live analytics AI. At least 16 characters.
JUDGE_PASSWORD=""
# Register the deployed HTTPS listener with the same PayPal Sandbox app.
PAYPAL_WEBHOOK_ID=""
# Optional read-only GitHub API token for public PR/check rate limits.
GITHUB_TOKEN=""
# Optional AG Studio trial/judging licence, passed to its browser provider.
AG_STUDIO_LICENSE_KEY=""

# Optional: dedicated disposable Neon branch for integration tests.
TEST_DATABASE_URL=""
